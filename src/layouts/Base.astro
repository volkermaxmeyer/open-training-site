---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** Start page and sessions use the full width on a laptop or iPad held sideways; text pages keep a reading width. */
  wide?: boolean;
}
const { title, description, noindex = false, wide = false } = Astro.props;
// Preload the three bundled woff2 files so headings don't swap fonts on first paint (same files the CSS imports).
import poppins600 from "@fontsource/poppins/files/poppins-latin-600-normal.woff2?url";
import poppins700 from "@fontsource/poppins/files/poppins-latin-700-normal.woff2?url";
import crimson700 from "@fontsource/crimson-text/files/crimson-text-latin-700-normal.woff2?url";
const fonts = [poppins600, poppins700, crimson700];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    {fonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    {/* ?v= forces browsers that cached the old Astro icon to fetch the ball; raise it when the icon changes */}
    <link rel="icon" href="/favicon.ico?v=2" sizes="32x32" />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <title>{title}</title>
    {/* Own visits don't count (Volker, 2026-11-05): a browser that pressed the button on the hidden "Not me" page carries
        va-disable, and the analytics loader drops its events. Must run before the loader, so it is a plain inline script. */}
    <script is:inline>
      window.webAnalyticsBeforeSend = (event) => {
        try { if (localStorage.getItem("va-disable")) return null; } catch {}
        return event;
      };
    </script>
    <Analytics />
    <SpeedInsights />
  </head>
  <body class="bg-paper font-sans text-ink antialiased">
    {/* From lg every page shares the same 1120 px frame, so the footer links stay in one place from page to page
        (Volker, 2026-11-07). Text pages keep a reading measure of 600 px (about 74 characters) inside it, left-aligned.
        684 px gave ~88 characters a line in the system font, 65ch even more (audit 2026-11-07). */}
    <div class="mx-auto flex min-h-screen max-w-[430px] flex-col px-4 tablet:max-w-[720px] lg:max-w-[1120px] lg:px-8">
      <main class:list={["flex-1 pt-4 pb-8 tablet:pt-8", !wide && "tablet:w-full tablet:max-w-[600px]"]}><slot /></main>
      <footer class="mt-4 flex flex-wrap gap-x-6 gap-y-1 border-t-2 border-ink py-2 text-base">
        <a href="/about/" class="inline-flex min-h-12 items-center underline underline-offset-4">About</a>
        <a href="/overview/" class="inline-flex min-h-12 items-center underline underline-offset-4">Overview</a>
        <a href="/imprint/" class="inline-flex min-h-12 items-center underline underline-offset-4">Imprint</a>
        <a href="/privacy/" class="inline-flex min-h-12 items-center underline underline-offset-4">Privacy</a>
      </footer>
    </div>
  </body>
</html>
