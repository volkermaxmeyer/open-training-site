---
import "../styles/global.css";
import { site } from "../site.config";
import Analytics from "@vercel/analytics/astro";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const version = (process.env.VERCEL_GIT_COMMIT_SHA ?? "local").slice(0, 7);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <Analytics />
  </head>
  <body class="bg-paper font-sans text-ink antialiased">
    <div class="mx-auto flex min-h-screen max-w-[430px] flex-col px-4">
      <header class="py-4">
        <a href="/" class="inline-block py-2 font-head text-xl font-bold">{site.name}</a>
      </header>
      <main class="flex-1 pb-8"><slot /></main>
      <footer class="mt-4 flex flex-wrap gap-x-6 gap-y-1 border-t-2 border-ink py-2 text-base">
        <a href="/imprint/" class="inline-flex min-h-12 items-center underline">Imprint</a>
        <a href="/privacy/" class="inline-flex min-h-12 items-center underline">Privacy</a>
        <span class="inline-flex min-h-12 items-center">v {version}</span>
      </footer>
    </div>
  </body>
</html>
