---
// The Open Training pickleball: neon-green ball, ink outline, the holes that make it a pickleball and not a tennis ball.
// The same drawing is public/favicon.svg.
interface Props {
  size?: number;
  class?: string;
}
const { size = 48, class: className = "" } = Astro.props;
---

<svg aria-hidden="true" width={size} height={size} viewBox="0 0 64 64" class={className}>
  <circle cx="32" cy="32" r="28" fill="var(--color-go)" stroke="var(--color-ink)" stroke-width="4" />
  <g fill="var(--color-ink)">
    <circle cx="32" cy="16" r="3.2" />
    <circle cx="19" cy="24" r="3.2" />
    <circle cx="45" cy="24" r="3.2" />
    <circle cx="32" cy="32" r="3.2" />
    <circle cx="19" cy="40" r="3.2" />
    <circle cx="45" cy="40" r="3.2" />
    <circle cx="32" cy="48" r="3.2" />
  </g>
</svg>
