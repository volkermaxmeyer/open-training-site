---
// Breadcrumbs on the session, shot and drill pages (Volker 2026-11-07, style 1 of three previews): one line in the
// label type, links underlined, the last level plain. They replace the old back link and the label above the title.
// Each link is at least 44 px high to tap; the separator ends a line, so a wrapped line starts with a level, not "›".
interface Props {
  items: { label: string; href?: string }[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" data-breadcrumbs class="mb-1">
  <ol class="flex flex-wrap items-center gap-x-2 font-head text-[14px] font-semibold tracking-[0.08em] uppercase">
    {items.map((item, i) => (
      <li class="flex items-center gap-x-2">
        {item.href ? (
          <a href={item.href} class="inline-flex min-h-11 items-center underline underline-offset-4">{item.label}</a>
        ) : (
          <span aria-current={i === items.length - 1 ? "location" : undefined} class="inline-flex items-center py-1">{item.label}</span>
        )}
        {i < items.length - 1 && <span aria-hidden="true" class="text-[16px]">›</span>}
      </li>
    ))}
  </ol>
</nav>
