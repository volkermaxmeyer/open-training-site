---
// The in-card video player, shared by session pages and drill pages (moved out of s/[slug].astro 2026-11-07).
---

<script is:inline>
  // The one exception to "no JavaScript" besides analytics (DESIGN.md): a tap on the video area plays the drill
  // segment inside the card. Without this script the area is a plain link to YouTube. Replay inserts a fresh iframe
  // instead of resetting src, so the back gesture still leaves the page.
  // Players talk to the page through YouTube's postMessage protocol (no extra script from YouTube): when one starts
  // playing, every other player on the page pauses in place, so only one video plays at a time (Volker, 2026-11-04).
  const players = [];
  function send(frame, msg) {
    frame.contentWindow && frame.contentWindow.postMessage(JSON.stringify(msg), "https://www.youtube-nocookie.com");
  }
  function pauseOthers(except) {
    players.forEach((p) => p.frame !== except && send(p.frame, { event: "command", func: "pauseVideo", args: "" }));
  }
  function playerFor(a) {
    const f = document.createElement("iframe");
    f.src = "https://www.youtube-nocookie.com/embed/" + a.dataset.id + "?start=" + a.dataset.start + "&end=" + a.dataset.end + "&autoplay=1&playsinline=1&rel=0&enablejsapi=1&origin=" + encodeURIComponent(location.origin);
    f.title = a.dataset.title + " – drill video";
    f.allow = "autoplay; encrypted-media; picture-in-picture";
    f.setAttribute("allowfullscreen", "");
    f.tabIndex = 0;
    f.style.cssText = "aspect-ratio:16/9;width:100%;border:0;display:block;scroll-margin-top:6rem";
    f.addEventListener("load", () => send(f, { event: "listening", id: a.dataset.id, channel: "widget" }));
    return f;
  }
  window.addEventListener("message", (e) => {
    if (e.origin !== "https://www.youtube-nocookie.com") return;
    let data;
    try { data = JSON.parse(e.data); } catch { return; }
    const playing = data && data.info && data.info.playerState === 1;
    if (!playing) return;
    const p = players.find((x) => x.frame.contentWindow === e.source);
    if (p) pauseOthers(p.frame);
  });
  document.querySelectorAll("[data-video]").forEach((a) => {
    a.addEventListener("click", (e) => {
      e.preventDefault();
      const box = a.parentElement;
      const current = { frame: playerFor(a) };
      pauseOthers(null);
      a.replaceWith(current.frame);
      current.frame.focus();
      players.push(current);
      // Replay inserts a fresh iframe instead of resetting src, so the back gesture still leaves the page.
      const replay = document.createElement("button");
      replay.type = "button";
      replay.textContent = "\u21BA Replay the drill";
      // Inside the player box, so from lg it is a bar on the video (Volker, 2026-11-07). The box bleeds 1rem past the
      // card padding on the phone; mx-4 and the calc width take that back, so on the phone it sits where it always did.
      replay.className = "mx-4 mt-4 flex min-h-12 w-[calc(100%-2rem)] items-center justify-center border-2 border-ink bg-card font-head font-bold lg:m-0 lg:min-h-13 lg:w-full lg:border-0 lg:border-t-2";
      replay.addEventListener("click", () => {
        pauseOthers(current.frame);
        const next = playerFor(a);
        current.frame.replaceWith(next);
        current.frame = next;
      });
      box.append(replay);
    });
  });
</script>
