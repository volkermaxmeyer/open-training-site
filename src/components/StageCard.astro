---
import type { Stage } from "../lib/session-schema";

interface Props {
  stage: Stage;
  number: number;
}
const { stage, number } = Astro.props;
const block = ["bg-stage-1", "bg-stage-2", "bg-stage-3"][number - 1];
---

<section
  data-stage-card
  id={`stage-${number}`}
  class="mt-7 scroll-mt-16 border-2 border-ink bg-card shadow-[6px_6px_0_var(--color-ink)]"
>
  <div class="flex border-b-2 border-ink">
    <div class={`${block} min-w-18 border-r-2 border-ink px-4 py-2 text-center font-display text-[64px] leading-none font-bold`}>
      {number}
    </div>
    <div class="flex flex-col justify-center px-3.5 py-2.5">
      <p class="font-head text-[14px] font-semibold tracking-[0.08em] text-ink-soft uppercase">Stage {number}</p>
      <h2 class="mt-0.5 font-head text-[26px] leading-tight font-bold">{stage.title}</h2>
    </div>
  </div>
  <div class="px-4 pt-3.5 pb-4">
    {stage.drill.isNew && (
      <p class="mb-3 inline-block border-2 border-ink bg-badge px-3 py-1 font-head text-base font-semibold text-badge-ink">
        New — tell us how it went
      </p>
    )}
    <ul class="list-disc space-y-3.5 pl-5.5 marker:text-ink">
      {stage.rules.map((rule) => <li>{rule}</li>)}
    </ul>
    <a
      href={stage.drill.watchUrl}
      target="_blank"
      rel="noopener"
      class="mt-3.5 flex min-h-14 items-center justify-center bg-ink px-4 py-3 text-center font-head text-base font-semibold text-on-ink"
    >
      ▶ Watch: {stage.drill.watchLabel}
    </a>
    <details class="mt-4 border-t-2 border-ink">
      <summary class="flex min-h-13 cursor-pointer items-center font-head font-bold">Too easy? Too hard?</summary>
      <p class="mb-2.5"><strong>Too easy:</strong> {stage.tooEasy}</p>
      <p class="mb-2.5"><strong>Too hard:</strong> {stage.tooHard}</p>
      {stage.goodLooksLike && <p class="mb-2.5"><strong>Good looks like:</strong> {stage.goodLooksLike}</p>}
    </details>
  </div>
</section>
