---
import type { Stage } from "../lib/session-schema";
import Chip from "./Chip.astro";
import { site, stagePlayersLabel } from "../site.config";

interface Props {
  stage: Stage;
  number: number;
  minutes: number;
  /** Player count of the first drill: a drill that needs more is flagged. */
  basePlayers: Stage["drill"]["players"];
}
const { stage, number, minutes, basePlayers } = Astro.props;
// "ThatPickleballGuy - Kyle Koszuta @12:25" -> "ThatPickleballGuy at 12:25": fits one line, and "@" read like a handle.
const short = stage.drill.watchLabel.replace(/^(.+?) - .+?( @|$)/, "$1$2");
const [channel, time] = short.split(" @");
const { videoId, start, end } = stage.drill;
const segment = videoId !== undefined && start !== undefined && end !== undefined;
const mins = segment ? Math.max(1, Math.round((end - start) / 60)) : 0;
const needsMore = stage.drill.players !== basePlayers;
const block = ["bg-stage-1", "bg-stage-2", "bg-stage-3"][number - 1];
---

<section
  data-stage-card
  id={`stage-${number}`}
  class="mt-7 scroll-mt-24 border-2 border-ink bg-card shadow-[6px_6px_0_var(--color-ink)]"
>
  <div class="flex border-b-2 border-ink">
    <div class={`${block} min-w-18 border-r-2 border-ink px-4 py-2 text-center font-display text-[64px] leading-none font-bold`}>
      {number}
    </div>
    <div class="flex flex-col justify-center gap-2 px-3.5 py-2.5">
      <h2 class="font-head text-[26px] leading-tight font-bold">{stage.title}</h2>
      <div class="flex flex-wrap gap-1.5">
        <Chip data-minutes>{minutes} min</Chip>
        <Chip data-players-badge tone={needsMore ? "warn" : "people"} icon>{stagePlayersLabel(stage.drill.players, basePlayers)}</Chip>
      </div>
    </div>
  </div>
  {/* From lg the body is two columns: the video (always 16:9, before and after play) on the left, the text on the right,
      placed with lg:col-start-2. The replay bar is added inside data-player by the page script, so it stays on the
      video. -mb-[2px] lets the player's bottom rule sit on the card's own border when the video is the taller column. */}
  <div class="px-4 pt-4 pb-4 lg:grid lg:grid-cols-[minmax(0,11fr)_minmax(0,9fr)] lg:items-start lg:gap-x-7 lg:p-0 lg:pr-6">
    {segment ? (
      <div data-player class="-mx-4 -mt-4 lg:row-span-5 lg:m-0 lg:-mb-[2px] lg:border-r-2 lg:border-b-2 lg:border-ink">
        <a
          data-video
          data-id={videoId}
          data-start={start}
          data-end={end}
          data-title={stage.title}
          role="button"
          href={stage.drill.watchUrl}
          target="_blank"
          rel="noopener"
          class="flex aspect-video w-full flex-col items-center justify-center gap-1.5 bg-ink px-4 text-center font-head text-on-ink"
        >
          <span aria-hidden="true" class="flex h-15 w-15 items-center justify-center rounded-full border-2 border-on-ink text-2xl">{"\u25B6\uFE0E"}</span>
          <span class="text-xl font-bold">Play the drill here</span>
          <span class="text-[14px] font-semibold text-balance opacity-90">{channel} · <span class="whitespace-nowrap">{time} · about {mins} min · YouTube</span></span>
        </a>
      </div>
    ) : (
      <a
        data-watch
        href={stage.drill.watchUrl}
        target="_blank"
        rel="noopener"
        class="flex min-h-18 flex-col items-center justify-center bg-ink px-4 py-3 text-center font-head text-on-ink lg:row-span-5"
      >
        <span class="text-xl font-bold"><span aria-hidden="true">{"\u25B6\uFE0E"}</span> Watch the drill<span class="sr-only"> (opens YouTube)</span></span>
        <span class="mt-0.5 text-base font-semibold text-balance">{channel}{time && <span class="whitespace-nowrap"> at {time}</span>} on YouTube</span>
      </a>
    )}
    <p data-in-short class="mt-3.5 text-[19px] leading-snug tablet:max-w-[62ch] lg:col-start-2 lg:mt-5">{stage.inShort}</p>
    {stage.onlyTwo && (
      <p data-pair-hint class="mt-2.5 border-l-[6px] border-ink bg-chip px-3 py-2 lg:col-start-2">
        <span class="block font-head text-[14px] font-semibold tracking-[0.08em] uppercase">{site.pairHint}</span>
        <span class="block">{stage.onlyTwo}</span>
      </p>
    )}
    <details class="mt-4 border-t-2 border-ink lg:col-start-2">
      <summary class="flex min-h-13 cursor-pointer items-center font-head font-bold">How to play</summary>
      <ul class="mb-2.5 list-disc space-y-3.5 pl-5.5 marker:text-ink">
        {stage.rules.map((rule) => <li>{rule}</li>)}
      </ul>
    </details>
    <details class="border-t-2 border-ink lg:col-start-2 lg:mb-3">
      <summary class="flex min-h-13 cursor-pointer items-center font-head font-bold">Too easy? Too hard?</summary>
      <p class="mb-2.5"><strong>Too easy:</strong> {stage.tooEasy}</p>
      <p class="mb-2.5"><strong>Too hard:</strong> {stage.tooHard}</p>
      {stage.goodLooksLike && <p class="mb-2.5"><strong>Good looks like:</strong> {stage.goodLooksLike}</p>}
    </details>
  </div>
</section>
