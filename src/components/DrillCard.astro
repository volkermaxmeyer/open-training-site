---
// The player card of one isolation drill (Shots area, 2026-11-07). Same look as StageCard, but the number block shows
// the drill number and there are no minutes: a drill page is not part of a timed session.
import type { DrillPage } from "../lib/session-schema";
import Chip from "./Chip.astro";
import { playersLabel } from "../site.config";

interface Props {
  card: DrillPage;
}
const { card } = Astro.props;
const short = card.drill.watchLabel.replace(/^(.+?) - .+?( @|$)/, "$1$2");
const [channel, time] = short.split(" @");
const { videoId, start, end } = card.drill;
const segment = videoId !== undefined && start !== undefined && end !== undefined;
const mins = segment ? Math.max(1, Math.round((end - start) / 60)) : 0;
---

<section data-drill-card class="mt-6 border-2 border-ink bg-card shadow-[6px_6px_0_var(--color-ink)]">
  <div class="flex border-b-2 border-ink">
    <div class="bg-stage-1 min-w-18 border-r-2 border-ink px-4 py-2 text-center font-display text-[56px] leading-none font-bold">{card.id}</div>
    <div class="flex flex-col justify-center gap-2 px-3.5 py-2.5">
      <h1 class="font-head text-[26px] leading-tight font-bold">{card.cardTitle}</h1>
      <div class="flex flex-wrap gap-1.5">
        <Chip data-players-badge tone="people" icon>{playersLabel(card.drill.players)}</Chip>
        {card.tested && <Chip data-tested>Tested on court</Chip>}
      </div>
    </div>
  </div>
  <div class="px-4 pt-4 pb-4 lg:grid lg:grid-cols-[minmax(0,11fr)_minmax(0,9fr)] lg:items-start lg:gap-x-7 lg:p-0 lg:pr-6">
    {segment ? (
      <div data-player class="-mx-4 -mt-4 lg:row-span-5 lg:m-0 lg:-mb-[2px] lg:border-r-2 lg:border-b-2 lg:border-ink">
        <a
          data-video
          data-id={videoId}
          data-start={start}
          data-end={end}
          data-title={card.cardTitle}
          role="button"
          href={card.drill.watchUrl}
          target="_blank"
          rel="noopener"
          class="flex aspect-video w-full flex-col items-center justify-center gap-1.5 bg-ink px-4 text-center font-head text-on-ink"
        >
          <span aria-hidden="true" class="flex h-15 w-15 items-center justify-center rounded-full border-2 border-on-ink text-2xl">{"▶︎"}</span>
          <span class="text-xl font-bold">Play the drill here</span>
          <span class="text-[14px] font-semibold text-balance opacity-90">{channel}&nbsp;· <span class="whitespace-nowrap">{time} · about {mins} min · YouTube</span></span>
        </a>
      </div>
    ) : (
      <a
        data-watch
        href={card.drill.watchUrl}
        target="_blank"
        rel="noopener"
        class="-mx-4 -mt-4 flex min-h-18 flex-col items-center justify-center bg-ink px-4 py-3 text-center font-head text-on-ink lg:row-span-5 lg:m-0"
      >
        <span class="text-xl font-bold"><span aria-hidden="true">{"▶︎"}</span> Watch the drill<span class="sr-only"> (opens YouTube)</span></span>
        <span class="mt-0.5 text-base font-semibold text-balance">{channel}{time && <span class="whitespace-nowrap"> at {time}</span>} on YouTube</span>
      </a>
    )}
    <p data-in-short class="mt-3.5 text-[19px] leading-snug tablet:max-w-[62ch] lg:col-start-2 lg:mt-5">{card.inShort}</p>
    <details class="mt-4 border-t-2 border-ink lg:col-start-2">
      <summary class="flex min-h-13 cursor-pointer items-center font-head font-bold">How to play</summary>
      <ul class="mb-2.5 list-disc space-y-3.5 pl-5.5 marker:text-ink">
        {card.rules.map((rule) => <li>{rule}</li>)}
      </ul>
    </details>
    <details class="border-t-2 border-ink lg:col-start-2 lg:mb-3">
      <summary class="flex min-h-13 cursor-pointer items-center font-head font-bold">Too easy? Too hard?</summary>
      <p class="mb-2.5"><strong>Too easy:</strong> {card.tooEasy}</p>
      <p class="mb-2.5"><strong>Too hard:</strong> {card.tooHard}</p>
      {card.goodLooksLike && <p class="mb-2.5"><strong>Good looks like:</strong> {card.goodLooksLike}</p>}
    </details>
  </div>
</section>
