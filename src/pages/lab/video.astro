---
// Unlisted phone test for "video in the card" (plan 2026-11-04, Step 0). Not linked from anywhere, noindex.
// Two real drills; end = start + 60 s is provisional. Remove or replace once the decision is made.
import Base from "../../layouts/Base.astro";
import BackLink from "../../components/BackLink.astro";

const clips = [
  { n: 1, title: "Count to 50", channel: "Jack Munro", id: "kSGkbMYudPE", start: 101, end: 161, url: "https://youtu.be/kSGkbMYudPE?t=101" },
  { n: 3, title: "Seven Against Eleven", channel: "Enhance Pickleball", id: "g5fkSrkpGSg", start: 726, end: 786, url: "https://youtu.be/g5fkSrkpGSg?t=726" },
];
const mmss = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`;
---

<Base title="Video test | Open Training" noindex>
  <BackLink />
  <h1 class="mt-1 font-display text-[44px] leading-none font-bold">Video test</h1>
  <p class="mt-3">
    A test page for playing the drill video inside the card. Tap a video, then check: does it start, stop after about a
    minute, and does "Replay" play the same part again?
  </p>
  {clips.map((c) => (
    <section class="mt-7 border-2 border-ink bg-card p-4 shadow-[6px_6px_0_var(--color-ink)]">
      <h2 class="font-head text-[26px] leading-tight font-bold">{c.title}</h2>
      <div class="mt-3" data-player>
        <a
          data-video
          data-id={c.id}
          data-start={c.start}
          data-end={c.end}
          data-title={c.title}
          role="button"
          href={c.url}
          target="_blank"
          rel="noopener"
          style="aspect-ratio: 16 / 9"
          class="flex w-full flex-col items-center justify-center gap-1.5 bg-ink px-4 text-center font-head text-on-ink"
        >
          <span aria-hidden="true" style="width:60px;height:60px;border-radius:50%;border:2px solid currentColor;font-size:24px" class="flex items-center justify-center">{"▶︎"}</span>
          <span class="text-xl font-bold">Play the drill here</span>
          <span class="text-base font-semibold">{c.channel} · {mmss(c.start)}–{mmss(c.end)} · about 1 min</span>
        </a>
      </div>
      <p class="mt-2 text-base"><a href={c.url} target="_blank" rel="noopener" class="underline underline-offset-4">or open it on YouTube</a></p>
    </section>
  ))}
  <script is:inline>
    // Tap -> privacy-friendly player for the drill segment only. Replay inserts a fresh iframe instead of resetting src,
    // so the back gesture still leaves the page instead of stepping through the player's history.
    function playerFor(a) {
      const f = document.createElement("iframe");
      f.src = "https://www.youtube-nocookie.com/embed/" + a.dataset.id + "?start=" + a.dataset.start + "&end=" + a.dataset.end + "&autoplay=1&playsinline=1&rel=0";
      f.title = a.dataset.title + " – drill video";
      f.allow = "autoplay; encrypted-media; picture-in-picture";
      f.setAttribute("allowfullscreen", "");
      f.style.cssText = "aspect-ratio:16/9;width:100%;border:2px solid var(--color-ink);display:block;scroll-margin-top:6rem";
      return f;
    }
    document.querySelectorAll("[data-video]").forEach((a) => {
      a.addEventListener("click", (e) => {
        e.preventDefault();
        const box = a.parentElement;
        let frame = playerFor(a);
        a.replaceWith(frame);
        frame.focus();
        const replay = document.createElement("button");
        replay.type = "button";
        replay.textContent = "↺ Replay the drill";
        replay.className = "mt-2 flex min-h-12 w-full items-center justify-center border-2 border-ink bg-card font-head font-bold";
        replay.addEventListener("click", () => {
          const next = playerFor(a);
          frame.replaceWith(next);
          frame = next;
        });
        box.append(replay);
      });
    });
  </script>
</Base>
