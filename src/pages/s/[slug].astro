---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import StageCard from "../../components/StageCard.astro";
import Chip from "../../components/Chip.astro";
import { playersFit, site } from "../../site.config";

export async function getStaticPaths() {
  const sessions = await getCollection("sessions");
  if (sessions.length > 0 && !site.tallyFormUrl.startsWith("https://")) {
    throw new Error(
      `site.tallyFormUrl is "${site.tallyFormUrl}": set a real https:// feedback form URL in src/site.config.ts (or TALLY_FORM_URL) before building with sessions.`,
    );
  }
  // "Got another 30 min?" names the next session's goal, not its title (wording pass 1.040, Volker 2026-11-12).
  const goalOf = new Map(sessions.map((s) => [s.data.slug, s.data.goal?.label]));
  return sessions.map((s) => ({
    params: { slug: s.data.slug },
    props: { session: s.data, nextLabel: s.data.next ? (goalOf.get(s.data.next.slug) ?? s.data.next.title) : undefined },
  }));
}

const { session, nextLabel } = Astro.props;
const feedbackUrl = `${site.tallyFormUrl}?session=${encodeURIComponent(session.slug)}`;
import Ball from "../../components/Ball.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import VideoPlayerScript from "../../components/VideoPlayerScript.astro";
---

<Base wide title={`${session.title} | ${site.name}`} description={session.aim} ogDescription={`${session.duration} min · ${playersFit(session.stages.map((s) => s.drill.players))} · ${site.level} · free, no login`}>
  {/* Breadcrumbs (2026-11-07): Goals, then the goal the player tapped on the home page, so its label and the session
      title read as one thing. They replace the back link and the goal label. */}
  <Breadcrumbs items={[{ label: "Goals", href: "/" }, ...(session.goal ? [{ label: session.goal.label }] : [])]} />
  <h1 class="mt-1 font-display text-[44px] leading-none font-bold tracking-[-0.02em] text-balance tablet:text-[60px]">{session.title}</h1>
  <div class="mt-2.5 flex flex-wrap gap-2">
    <Chip data-session-minutes>{session.duration} min</Chip>
    <Chip data-players-summary tone="people" icon>{playersFit(session.stages.map((s) => s.drill.players))}</Chip>
    <Chip data-level>{site.level}</Chip>
  </div>
  <nav aria-label="Jump to drill" class="sticky top-0 z-10 -mx-1 mt-6 flex gap-2.5 bg-paper px-1 pt-1 pb-2">
    {["var(--color-stage-1)", "var(--color-stage-2)", "var(--color-stage-3)"].map((tab, i) => (
      <a
        href={`#stage-${i + 1}`}
        data-n={i + 1}
        aria-label={`Jump to drill ${i + 1}`}
        style={`background: ${tab}`}
        class="flex min-h-14 flex-1 items-baseline justify-center gap-1.5 border-2 pt-2.5 border-ink focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-ink"
      >
        <span class="font-display text-[30px] leading-none font-bold">{i + 1}</span>
        <span class="font-head text-[14px] leading-none font-semibold tracking-[0.08em] uppercase">Drill</span>
      </a>
    ))}
  </nav>
  <p data-four-on-court class="mt-1 border-l-[6px] border-ink bg-warn px-3 py-2.5">
    {site.fourOnCourt.text} <strong>{site.fourOnCourt.rule}</strong>
  </p>
  <div class="mt-3">
    {session.stages.map((stage, i) => (
      <StageCard stage={stage} number={i + 1} minutes={Math.round(session.duration / 3)} basePlayers={session.stages[0].drill.players} />
    ))}
  </div>
  {/* From lg the closing is one row under a rule: three equally tall fields (Volker, 2026-11-07, "Eine Zeile").
      Below lg the wrapper has no style of its own, so the phone keeps the stacked order. */}
  <div data-closing class:list={["lg:mt-12 lg:grid lg:items-stretch lg:gap-x-6 lg:border-t-2 lg:border-ink lg:pt-7", session.next ? "lg:grid-cols-3" : "lg:grid-cols-2"]}>
  <div data-finish class="mt-12 flex items-center gap-3.5 lg:mt-0 lg:min-h-[96px]">
    <Ball size={52} class="finish-ball shrink-0" />
    <p class="font-head text-xl leading-tight font-bold">
      That's {session.duration} minutes.
      <span class="block font-sans text-[19px] font-normal">Good rally, everyone.</span>
    </p>
  </div>
  <a
    href={feedbackUrl}
    target="_blank"
    rel="noopener"
    class="mt-4 flex min-h-15 items-center justify-center border-2 border-ink bg-go px-4 py-3 font-head text-xl font-bold shadow-[6px_6px_0_var(--color-ink)] lg:mt-0 lg:min-h-[96px] lg:text-center"
  >
    Tell us how it went<span class="sr-only"> (opens in a new tab)</span>
  </a>
  {session.next && (
    <a
      data-next
      href={`/s/${session.next.slug}/`}
      class="mt-7 block min-h-14 border-2 border-ink bg-card p-4 shadow-[6px_6px_0_var(--color-ink)] lg:mt-0 lg:flex lg:min-h-[96px] lg:flex-col lg:justify-center active:translate-x-1 active:translate-y-1 active:shadow-none [@media(hover:hover)]:hover:translate-x-0.5 [@media(hover:hover)]:hover:translate-y-0.5 [@media(hover:hover)]:hover:shadow-[3px_3px_0_var(--color-ink)]"
    >
      <span class="block font-head text-[14px] font-semibold tracking-[0.08em] text-ink-soft uppercase">Got another 30 min?</span>
      <span class="mt-1 block font-head text-[22px] leading-tight font-bold">Next: {nextLabel} →</span>
    </a>
  )}
  </div>
  <VideoPlayerScript />
</Base>
