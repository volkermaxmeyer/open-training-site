---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import StageCard from "../../components/StageCard.astro";
import { site } from "../../site.config";

export async function getStaticPaths() {
  const sessions = await getCollection("sessions");
  if (sessions.length > 0 && !site.tallyFormUrl.startsWith("https://")) {
    throw new Error(
      `site.tallyFormUrl is "${site.tallyFormUrl}": set a real https:// feedback form URL in src/site.config.ts (or TALLY_FORM_URL) before building with sessions.`,
    );
  }
  return sessions.map((s) => ({ params: { slug: s.data.slug }, props: { session: s.data } }));
}

const { session } = Astro.props;
const feedbackUrl = `${site.tallyFormUrl}?session=${encodeURIComponent(session.slug)}`;
---

<Base title={`${session.title} | ${site.name}`} description={session.aim}>
  <nav aria-label="Jump to stage" class="sticky top-0 z-10 -mx-4 flex gap-0.5 border-y-2 border-ink bg-ink">
    {["bg-stage-1", "bg-stage-2", "bg-stage-3"].map((bg, i) => (
      <a href={`#stage-${i + 1}`} aria-label={`Jump to stage ${i + 1}`} class={`${bg} flex min-h-12 flex-1 items-center justify-center font-display active:bg-ink active:text-on-ink focus-visible:outline-3 focus-visible:-outline-offset-[7px] focus-visible:outline-ink text-[34px] leading-none font-bold`}>
        {i + 1}
      </a>
    ))}
  </nav>
  <h1 class="mt-4 font-display text-[44px] leading-none font-bold tracking-[-0.02em]">{session.title}</h1>
  {session.status !== "tested" && (
    <p data-session-badge class="mt-3 inline-block border-2 border-ink bg-badge px-3 py-1 font-head text-base font-semibold text-badge-ink">
      New — tell us how it went
    </p>
  )}
  <p class="mt-3 text-[19px]">{session.aim}</p>
  <p class="mt-3 font-semibold">{session.duration} min</p>
  <div>
    {session.stages.map((stage, i) => <StageCard stage={stage} number={i + 1} />)}
  </div>
  <a
    href={feedbackUrl}
    class="mt-9 flex min-h-15 items-center justify-center border-2 border-ink bg-go px-4 py-3 font-head text-xl font-bold shadow-[6px_6px_0_var(--color-ink)]"
  >
    Tell us how it went
  </a>
</Base>
