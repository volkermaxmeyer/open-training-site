---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import StageCard from "../../components/StageCard.astro";
import Chip from "../../components/Chip.astro";
import { playersFit, site } from "../../site.config";

export async function getStaticPaths() {
  const sessions = await getCollection("sessions");
  if (sessions.length > 0 && !site.tallyFormUrl.startsWith("https://")) {
    throw new Error(
      `site.tallyFormUrl is "${site.tallyFormUrl}": set a real https:// feedback form URL in src/site.config.ts (or TALLY_FORM_URL) before building with sessions.`,
    );
  }
  return sessions.map((s) => ({ params: { slug: s.data.slug }, props: { session: s.data } }));
}

const { session } = Astro.props;
const feedbackUrl = `${site.tallyFormUrl}?session=${encodeURIComponent(session.slug)}`;
import Ball from "../../components/Ball.astro";
import BackLink from "../../components/BackLink.astro";
---

<Base title={`${session.title} | ${site.name}`} description={session.aim}>
  <BackLink />
  <h1 class="mt-1 font-display text-[44px] leading-none font-bold tracking-[-0.02em] text-balance">{session.title}</h1>
  <div class="mt-2.5 flex flex-wrap gap-2">
    <Chip data-session-minutes>{session.duration} min</Chip>
    <Chip data-players-summary tone="people" icon>{playersFit(session.stages.map((s) => s.drill.players))}</Chip>
  </div>
  <nav aria-label="Jump to drill" class="sticky top-0 z-10 -mx-1 mt-6 flex gap-2.5 bg-paper px-1 pt-1 pb-2">
    {["var(--color-stage-1)", "var(--color-stage-2)", "var(--color-stage-3)"].map((tab, i) => (
      <a
        href={`#stage-${i + 1}`}
        data-n={i + 1}
        aria-label={`Jump to drill ${i + 1}`}
        style={`background: ${tab}`}
        class="flex min-h-14 flex-1 items-baseline justify-center gap-1.5 border-2 pt-2.5 border-ink focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-ink"
      >
        <span class="font-display text-[30px] leading-none font-bold">{i + 1}</span>
        <span class="font-head text-[14px] leading-none font-semibold tracking-[0.08em] uppercase">Drill</span>
      </a>
    ))}
  </nav>
  <p data-four-on-court class="mt-1 border-l-[6px] border-ink bg-warn px-3 py-2.5">
    {site.fourOnCourt.text} <strong>{site.fourOnCourt.rule}</strong>
  </p>
  <div class="mt-3">
    {session.stages.map((stage, i) => (
      <StageCard stage={stage} number={i + 1} minutes={Math.round(session.duration / 3)} basePlayers={session.stages[0].drill.players} />
    ))}
  </div>
  <div data-finish class="mt-12 flex items-center gap-3.5">
    <Ball size={52} class="finish-ball shrink-0" />
    <p class="font-head text-xl leading-tight font-bold">
      That's {session.duration} minutes.
      <span class="block font-sans text-[19px] font-normal">Good rally, everyone.</span>
    </p>
  </div>
  <a
    href={feedbackUrl}
    target="_blank"
    rel="noopener"
    class="mt-4 flex min-h-15 items-center justify-center border-2 border-ink bg-go px-4 py-3 font-head text-xl font-bold shadow-[6px_6px_0_var(--color-ink)]"
  >
    Tell us how it went<span class="sr-only"> (opens in a new tab)</span>
  </a>
  {session.next && (
    <a
      data-next
      href={`/s/${session.next.slug}/`}
      class="mt-7 block min-h-14 border-2 border-ink bg-card p-4 shadow-[6px_6px_0_var(--color-ink)] active:translate-x-1 active:translate-y-1 active:shadow-none [@media(hover:hover)]:hover:translate-x-0.5 [@media(hover:hover)]:hover:translate-y-0.5 [@media(hover:hover)]:hover:shadow-[3px_3px_0_var(--color-ink)]"
    >
      <span class="block font-head text-[14px] font-semibold tracking-[0.08em] text-ink-soft uppercase">Got another 30 min?</span>
      <span class="mt-1 block font-head text-[22px] leading-tight font-bold">Next: {session.next.title} →</span>
    </a>
  )}
  <script is:inline>
    // The one exception to "no JavaScript" besides analytics (DESIGN.md): a tap on the video area plays the drill
    // segment inside the card. Without this script the area is a plain link to YouTube. Replay inserts a fresh iframe
    // instead of resetting src, so the back gesture still leaves the page.
    // Players talk to the page through YouTube's postMessage protocol (no extra script from YouTube): when one starts
    // playing, every other player on the page pauses in place, so only one video plays at a time (Volker, 2026-11-04).
    const players = [];
    function send(frame, msg) {
      frame.contentWindow && frame.contentWindow.postMessage(JSON.stringify(msg), "https://www.youtube-nocookie.com");
    }
    function pauseOthers(except) {
      players.forEach((p) => p.frame !== except && send(p.frame, { event: "command", func: "pauseVideo", args: "" }));
    }
    function playerFor(a) {
      const f = document.createElement("iframe");
      f.src = "https://www.youtube-nocookie.com/embed/" + a.dataset.id + "?start=" + a.dataset.start + "&end=" + a.dataset.end + "&autoplay=1&playsinline=1&rel=0&enablejsapi=1&origin=" + encodeURIComponent(location.origin);
      f.title = a.dataset.title + " – drill video";
      f.allow = "autoplay; encrypted-media; picture-in-picture";
      f.setAttribute("allowfullscreen", "");
      f.tabIndex = 0;
      f.style.cssText = "aspect-ratio:16/9;width:100%;border:0;display:block;scroll-margin-top:6rem";
      f.addEventListener("load", () => send(f, { event: "listening", id: a.dataset.id, channel: "widget" }));
      return f;
    }
    window.addEventListener("message", (e) => {
      if (e.origin !== "https://www.youtube-nocookie.com") return;
      let data;
      try { data = JSON.parse(e.data); } catch { return; }
      const playing = data && data.info && data.info.playerState === 1;
      if (!playing) return;
      const p = players.find((x) => x.frame.contentWindow === e.source);
      if (p) pauseOthers(p.frame);
    });
    document.querySelectorAll("[data-video]").forEach((a) => {
      a.addEventListener("click", (e) => {
        e.preventDefault();
        const box = a.parentElement;
        const current = { frame: playerFor(a) };
        pauseOthers(null);
        a.replaceWith(current.frame);
        current.frame.focus();
        players.push(current);
        // Replay inserts a fresh iframe instead of resetting src, so the back gesture still leaves the page.
        const replay = document.createElement("button");
        replay.type = "button";
        replay.textContent = "\u21BA Replay the drill";
        replay.className = "mt-4 flex min-h-12 w-full items-center justify-center border-2 border-ink bg-card font-head font-bold";
        replay.addEventListener("click", () => {
          pauseOthers(current.frame);
          const next = playerFor(a);
          current.frame.replaceWith(next);
          current.frame = next;
        });
        box.after(replay);
      });
    });
  </script>
</Base>
