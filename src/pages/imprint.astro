---
import Base from "../layouts/Base.astro";
import { site } from "../site.config";
---

<Base title={`Imprint | ${site.name}`} noindex>
  <h1 class="mt-2 font-display text-[44px] leading-none font-bold">Imprint</h1>
  <p class="mt-4">{site.imprint.name}<br />{site.imprint.street}<br />{site.imprint.city}</p>
  <p class="mt-2">Contact: {site.contactEmail}</p>
</Base>
