---
import Base from "../layouts/Base.astro";
import { site } from "../site.config";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { version } from "../version.json";
---

<Base title={`Imprint | ${site.name}`} noindex>
  <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Imprint" }]} />
  <h1 class="mt-1 font-display text-[44px] leading-none font-bold">Imprint</h1>
  <p class="mt-4">{site.imprint.name}{site.imprint.address.map((line) => <><br />{line}</>)}</p>
  <p class="mt-2">Contact: {site.contactEmail}</p>
  <p class="mt-4">A private, non-commercial project.<br />Not an offer of BTV Olympia e.V.</p>
  <p class="mt-4">Information according to § 18 (1) MStV.</p>
  <p data-version class="mt-8 border-t border-ink/30 pt-3 text-sm">Version {version}</p>
</Base>
