---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { site } from "../site.config";

const sessions = (await getCollection("sessions")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
---

<Base title={site.name} description="Good training, no coach. Four players, one court, about 30 minutes.">
  <h1 class="mt-2 font-display text-[44px] leading-none font-bold tracking-[-0.02em]">Good training, no coach</h1>
  <p class="mt-3 text-[19px]">Four players, one court, about 30 minutes. Pick a session and follow the three stages on your phone.</p>
  {sessions.length === 0 ? (
    <p class="mt-8 border-2 border-dashed border-ink bg-card p-4">
      No sessions yet. Check back soon.
    </p>
  ) : (
    <ul class="mt-7 space-y-5">
      {sessions.map(({ data }) => (
        <li>
          <a href={`/s/${data.slug}/`} class="block min-h-14 border-2 border-ink bg-card p-4 shadow-[6px_6px_0_var(--color-ink)] active:translate-x-1 active:translate-y-1 active:shadow-none">
            <span class="block font-head text-[22px] leading-tight font-bold">{data.title}</span>
            <span class="mt-1 block">{data.aim}</span>
            <span class="mt-1 block font-semibold text-ink-soft">{data.duration} min</span>
          </a>
        </li>
      ))}
    </ul>
  )}
</Base>
