---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Chip from "../components/Chip.astro";
import { playersFitParts, site } from "../site.config";
import { cardText } from "../lib/sessions";
import HomeTabs from "../components/HomeTabs.astro";

const sessions = (await getCollection("sessions")).map((s) => s.data);
const withGoal = sessions
  .filter((s) => s.goal)
  .sort((a, b) => a.goal!.order - b.goal!.order || a.title.localeCompare(b.title));
const others = sessions.filter((s) => !s.goal).sort((a, b) => a.title.localeCompare(b.title));
// When every session starts with the same player count, its chip said the same thing on every card: say it once above
// the list instead (design critique 2026-11-07, like the minutes chip on 2026-11-04). The warn chips stay on the cards.
const bases = new Set(sessions.map((s) => playersFitParts(s.stages.map((st) => st.drill.players)).base));
const sharedBase = bases.size === 1 ? [...bases][0] : undefined;
---

<Base wide title={site.name} description="Pick a goal for a 30-minute session, or a single shot to practise on its own. Ready-made drills with video, on your phone.">
  <HomeTabs active="goals" />
  <h1 class="mt-7 font-display text-[44px] leading-none font-bold tracking-[-0.02em] text-balance tablet:text-[60px]">{site.goalQuestion}</h1>
  {sessions.length === 0 ? (
    <p class="mt-8 border-2 border-dashed border-ink bg-card p-4">
      No sessions yet. Check back soon.
    </p>
  ) : (
    <>
    {/* One line instead of two (Volker 2026-11-07): what a session is, and the group size every session works with. */}
    <p data-tab-line class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1.5 text-[17px]">Pick a goal, get three drills, play 30 minutes.{sharedBase && <> For <Chip data-shared-base tone="people" icon>{sharedBase}</Chip>.</>}</p>
    <ul class="mt-7 space-y-4 tablet:grid tablet:grid-cols-2 tablet:gap-5 tablet:space-y-0 lg:grid-cols-3">
      {[...withGoal, ...others].map((data) => (
        <li>
          <a data-goal={data.goal?.id} href={`/s/${data.slug}/`} class="flex tablet:h-full min-h-[6.875rem] max-[359px]:min-h-[8.75rem] items-center gap-3 border-2 border-ink bg-card px-4 py-3 shadow-[6px_6px_0_var(--color-ink)] active:translate-x-1 active:translate-y-1 active:shadow-none [@media(hover:hover)]:hover:translate-x-0.5 [@media(hover:hover)]:hover:translate-y-0.5 [@media(hover:hover)]:hover:shadow-[3px_3px_0_var(--color-ink)]">
            <span class="flex min-w-0 flex-1 flex-col gap-2">
              <span class="block font-head text-[22px] leading-tight font-bold">{cardText(data, sessions).title}</span>
              {cardText(data, sessions).session && <span data-card-session class="block font-head text-[16px] leading-tight font-semibold">{cardText(data, sessions).session}</span>}
              {(!sharedBase || playersFitParts(data.stages.map((s) => s.drill.players)).extras.length > 0) && <span data-fit class="flex flex-wrap gap-1.5">
                {!sharedBase && <Chip data-chip-base tone="people" icon>{playersFitParts(data.stages.map((s) => s.drill.players)).base}</Chip>}
                {playersFitParts(data.stages.map((s) => s.drill.players)).extras.map((extra) => (
                  <Chip data-chip-extra tone="warn">{extra}</Chip>
                ))}
              </span>}
            </span>
            <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" class="shrink-0"><path d="M9 5l7 7-7 7" /></svg>
          </a>
        </li>
      ))}
    </ul>
    </>
  )}
</Base>
