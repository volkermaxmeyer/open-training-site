---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { site } from "../site.config";

const sessions = (await getCollection("sessions")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
---

<Base title={site.name} description="Good training, no coach. Four players, one court, about 30 minutes.">
  <h1 class="text-3xl font-bold">Good training, no coach</h1>
  <p class="mt-2">Four players, one court, about 30 minutes. Pick a session and follow the three stages on your phone.</p>
  {sessions.length === 0 ? (
    <p class="mt-8 rounded-2xl border-2 border-dashed border-slate-300 p-4">
      No sessions yet. Check back soon.
    </p>
  ) : (
    <ul class="mt-6 space-y-3">
      {sessions.map(({ data }) => (
        <li>
          <a href={`/s/${data.slug}/`} class="block min-h-14 rounded-2xl border-2 border-slate-300 p-4">
            <span class="block text-xl font-bold">{data.title}</span>
            <span class="mt-1 block">{data.aim}</span>
            <span class="mt-1 block text-base text-slate-600">{data.duration} min</span>
          </a>
        </li>
      ))}
    </ul>
  )}
</Base>
